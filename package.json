{
  "name": "waypoint",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first project waypoint with a web dashboard, REST API, and an MCP server so AI editors (Claude Code, Cursor, Antigravity) can read and log your project context automatically.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/mcp",
    "packages/cli",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch packages/server/src/index.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node packages/server/src/index.js",
    "mcp": "node packages/mcp/src/index.js",
    "waypoint": "node packages/cli/src/index.js",
    "seed": "node packages/core/src/seed.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
